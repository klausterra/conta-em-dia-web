rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Maps a user to the household they belong to.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /households/{householdId} {
      // Any signed-in user can look up a household by its (unguessable) id
      // to join it via invite code, but the collection can't be listed.
      allow get: if request.auth != null;
      allow list: if false;

      // Creating a household: you must add yourself as the sole member.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 1;

      allow update: if request.auth != null
        && (
          // Existing members can update freely (rename, manage members, profiles, etc).
          request.auth.uid in resource.data.members
          // Joining: append own uid (optionally also set memberProfiles / invites).
          || (
            !(request.auth.uid in resource.data.members)
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['members', 'memberProfiles', 'invites'])
          )
        );

      allow delete: if false;

      match /bills/{billId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
    }
  }
}
